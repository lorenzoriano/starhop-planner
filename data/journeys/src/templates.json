    {
      "id": "A10-stars-that-change", "retired": true, "archetype": "A10", "title": "Stars That Change",
      "titleKeys": ["title.A10-stars-that-change"],
      "drivingQuestion": "Aren't stars constant?",
      "questionKeys": ["question.A10-stars-that-change"],
      "hookLine": "Catch stars that wink, breathe and hide. You'll judge their brightness yourself.",
      "hookKeys": ["hook.A10-stars-that-change"],
      "payoffKeys": ["payoff.A10-stars-that-change"],
      "themeTags": ["variable-stars", "moonlit", "citizen-science"],
      "orderingPrinciple": "By mechanism: an eclipse first, then pulsation, then dust or flare events. Every card asks the observer to compare the star with nearby reference stars. Never state a volatile star's current brightness. The opening and closing stars must swing visibly: at least 0.3 mag between vMax and vMin when known (candidates.variableStopOk); microvariables only as supporting stops.",
      "slots": [
        { "arc": "hook", "label": "Changing star", "match": { "roles": ["variable"], "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Eclipse", "match": { "variabilityClasses": ["eclipsing-algol", "eclipsing-beta-lyrae", "eclipsing-long-period"] }, "optional": true, "inEdges": ["SAME_PHYSICS", "CONTRAST", "SAME_FAMILY"] },
