        { "arc": "build", "label": "Heavyweight", "match": { "roles": ["supergiant"], "maxObsDifficulty": 2 }, "inEdges": ["CONTRAST", "SAME_PHYSICS"] },
        { "arc": "payoff", "label": "Shattered star", "match": { "roles": ["snr"], "maxObsDifficulty": 4 }, "inEdges": ["LIFE_NEXT", "CAUSE"] },
        { "arc": "coda", "label": "New beginnings", "match": { "roles": ["nursery"], "maxObsDifficulty": 3 }, "optional": true, "inEdges": ["LIFE_NEXT", "CAUSE", "SAME_PHYSICS"] }
      ],
