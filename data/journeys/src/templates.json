{
  "version": "templates-1",
  "templates": [
    {
      "id": "A1-cradle-to-grave", "archetype": "A1", "title": "Cradle to Grave",
      "titleKeys": ["title.A1-cradle-to-grave"],
      "drivingQuestion": "Where do stars come from, and how do they end?",
      "questionKeys": ["question.A1-cradle-to-grave"],
      "hookLine": "Follow one star's whole life, from glowing cradle to scattered ashes, in one sweep of sky.",
      "hookKeys": ["hook.A1-cradle-to-grave"],
      "payoffKeys": ["payoff.A1-cradle-to-grave"],
      "themeTags": ["lives-of-stars", "nurseries", "star-corpses"],
      "orderingPrinciple": "Life stage (evoStage) never goes backwards during the build. A flash-forward hook (open on the doomed star, then rewind to the nursery) is allowed, and the coda may call back to the nursery.",
      "slots": [
        { "arc": "hook", "label": "Nursery", "match": { "roles": ["nursery", "supergiant"], "minWow": 3, "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Newborn family", "match": { "roles": ["young-cluster", "association"], "evoStageIn": [1, 2] }, "repeat": [1, 3], "inEdges": ["LIFE_NEXT", "SIBLING", "CAUSE"] },
        { "arc": "twist", "label": "Impostor", "match": { "hasMisconception": true, "roles": ["giant", "adult-cluster", "old-cluster"] }, "optional": true },
        { "arc": "build", "label": "Grown-up family", "match": { "roles": ["adult-cluster", "old-cluster", "giant"], "evoStageIn": [3, 4, 5] }, "optional": true, "inEdges": ["LIFE_NEXT", "CONTRAST", "LINE_OF_SIGHT"] },
        { "arc": "payoff", "label": "Dying star", "match": { "roles": ["supergiant", "giant", "pn", "snr"], "evoStageIn": [5, 6, 7], "maxObsDifficulty": 3 }, "inEdges": ["LIFE_NEXT", "CONTRAST", "CAUSE"] },
        { "arc": "coda", "label": "What remains", "match": { "roles": ["snr", "pn", "nursery"], "maxObsDifficulty": 4 }, "optional": true, "inEdges": ["LIFE_NEXT", "CAUSE", "SAME_PHYSICS"] }
      ],
      "order": "partial", "swapGroups": [[2, 3]],
      "edges": ["LIFE_NEXT", "CAUSE", "SIBLING", "CONTRAST", "LINE_OF_SIGHT", "SAME_FAMILY", "SAME_PHYSICS"],
      "progression": { "property": "evoStage", "direction": "arc" },
      "length": [4, 7], "defaultLength": 5,
      "ingredients": {
        "roles": [
          { "anyOf": ["nursery"], "min": 1 },
          { "anyOf": ["young-cluster", "adult-cluster", "association"], "min": 1 },
          { "anyOf": ["giant", "supergiant", "pn", "snr"], "min": 1 }
        ],
        "minDistinctEvoStages": 3
      },
      "coreConcepts": ["LIFE.nursery", "LIFE.cluster-birth", "LIFE.giant", "LIFE.recycling"],
      "moonFriendly": false, "moonSuitability": "partial", "needsDark": false, "kidFriendly": true,
      "chainTo": ["A8-how-stars-die"],
      "switchRule": { "to": ["A8-how-stars-die"], "atArc": "payoff", "via": ["LIFE_NEXT", "CONTRAST"], "minStrength": 0.7, "announceKey": "switch.A1-cradle-to-grave" }
    },
    {
      "id": "A2-thermometer", "archetype": "A2", "title": "A Thermometer in the Sky",
      "titleKeys": ["title.A2-thermometer"],
      "drivingQuestion": "Why are stars different colors, and what does that tell us?",
      "questionKeys": ["question.A2-thermometer"],
      "hookLine": "Read the temperature of stars from their color, ember-orange to blue-white, by eye.",
      "hookKeys": ["hook.A2-thermometer"],
      "payoffKeys": ["payoff.A2-thermometer"],
      "themeTags": ["star-colours", "temperature", "moonlit"],
      "orderingPrinciple": "Surface temperature (teffK) climbs from the cool hook to the hottest payoff, with one high-contrast pair (often a color double) in the middle. The coda steps back to a Sun-like star in the middle of the scale.",
      "slots": [
        { "arc": "hook", "label": "Ember star", "match": { "kinds": ["star"], "factRanges": { "teffK": { "max": 4500 } }, "minWow": 3, "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Color step", "match": { "kinds": ["star"] }, "repeat": [1, 3], "inEdges": ["CONTRAST", "SAME_PHYSICS", "SIBLING"] },
        { "arc": "twist", "label": "Color clash", "match": { "roles": ["double", "supergiant"], "hasMisconception": true }, "optional": true, "inEdges": ["CONTRAST", "LINE_OF_SIGHT", "SAME_PHYSICS"] },
        { "arc": "payoff", "label": "Blue-hot star", "match": { "kinds": ["star"], "factRanges": { "teffK": { "min": 9000 } } }, "inEdges": ["CONTRAST", "SAME_PHYSICS"] },
        { "arc": "coda", "label": "The Sun's color", "match": { "kinds": ["star"], "factRanges": { "teffK": { "min": 5000, "max": 6500 } } }, "optional": true }
      ],
      "order": "partial", "swapGroups": [[1, 2]],
      "edges": ["CONTRAST", "SAME_PHYSICS", "SIBLING", "LINE_OF_SIGHT"],
      "progression": { "property": "teffK", "direction": "up" },
      "length": [4, 6], "defaultLength": 5,
      "ingredients": { "factSpans": [{ "fact": "teffK", "minSpan": 6000 }], "minStars": 4 },
      "coreConcepts": ["LIGHT.color-temp", "PERC.night-eyes", "STAR.size"],
      "moonFriendly": true, "moonSuitability": "bright-ok", "needsDark": false, "kidFriendly": true,
      "chainTo": ["A1-cradle-to-grave"],
      "switchRule": { "to": ["A1-cradle-to-grave"], "atArc": "payoff", "via": ["CONTRAST", "LIFE_NEXT"], "minStrength": 0.6, "announceKey": "switch.A2-thermometer" }
    },
    {
      "id": "A3-how-far", "archetype": "A3", "title": "How Far Is Far?",
      "titleKeys": ["title.A3-how-far"],
      "drivingQuestion": "Which of these is closest, and how do we know?",
      "questionKeys": ["question.A3-how-far"],
      "hookLine": "Climb a ladder of distances, each rung at least twice as far as the last.",
      "hookKeys": ["hook.A3-how-far"],
      "payoffKeys": ["payoff.A3-how-far"],
      "themeTags": ["distance", "scale", "how-we-know"],
      "orderingPrinciple": "Distance (distanceLy) strictly increases at every stop, each rung 2 to 15 times farther than the last; only the leap to another galaxy, from a rung at least 2,000 light-years out, may be longer (engine: candidates.ladderStepOk). The ladder ends on its farthest rung, never back home. The Deeper text names the measuring method at each rung: parallax, cluster fitting, standard candles.",
      "slots": [
        { "arc": "hook", "label": "Next-door star", "match": { "kinds": ["star"], "factRanges": { "distanceLy": { "max": 100 } }, "minWow": 3, "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Next rung", "match": {}, "repeat": [2, 4], "inEdges": ["SCALE", "TIME_MACHINE", "LINE_OF_SIGHT", "CONTRAST"] },
        { "arc": "twist", "label": "Far but blazing", "match": { "kinds": ["star"], "hasMisconception": true, "factRanges": { "lumLsun": { "min": 1000 } } }, "optional": true, "inEdges": ["SCALE", "CONTRAST", "LINE_OF_SIGHT"] },
        { "arc": "payoff", "label": "Farthest light", "match": { "roles": ["galaxy", "globular"], "maxObsDifficulty": 3 }, "inEdges": ["SCALE", "TIME_MACHINE"] }
      ],
      "order": "partial", "swapGroups": [[1, 2]],
      "edges": ["SCALE", "TIME_MACHINE", "CONTRAST", "LINE_OF_SIGHT", "SIBLING"],
      "progression": { "property": "distanceLy", "direction": "up" },
      "length": [5, 7], "defaultLength": 6,
      "ingredients": { "factSpans": [{ "fact": "distanceLy", "minRatio": 1000 }] },
      "coreConcepts": ["DIST.light-year", "DIST.lum-vs-app", "DIST.standard-candle", "SCALE.cosmic"],
      "moonFriendly": false, "moonSuitability": "partial", "needsDark": false, "kidFriendly": true,
      "chainTo": []
    },
    {
      "id": "A4-time-machine", "retired": true, "archetype": "A4", "title": "Time Machine",
      "titleKeys": ["title.A4-time-machine"],
      "drivingQuestion": "How old is the light hitting your eye right now?",
      "questionKeys": ["question.A4-time-machine"],
      "hookLine": "Every stop shows light from a different moment in history. Read it like a calendar.",
      "hookKeys": ["hook.A4-time-machine"],
      "payoffKeys": ["payoff.A4-time-machine"],
      "themeTags": ["lookback", "history", "distance"],
      "orderingPrinciple": "Light-travel time increases at every stop, each step 2 to 15 times older light (only the leap to another galaxy may be longer; candidates.ladderStepOk), ending on the oldest light. Each stop gets a historical anchor (this light left when ...). Never imply that a nearby naked-eye star may already be dead (MC5).",
      "slots": [
        { "arc": "hook", "label": "Recent light", "match": { "kinds": ["star"], "factRanges": { "distanceLy": { "max": 80 } }, "minWow": 3, "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Older light", "match": {}, "repeat": [1, 4], "inEdges": ["TIME_MACHINE", "SCALE", "LINE_OF_SIGHT", "SIBLING"] },
        { "arc": "twist", "label": "Still alive", "match": { "kinds": ["star"], "hasMisconception": true }, "optional": true, "inEdges": ["TIME_MACHINE", "SCALE", "CONTRAST"] },
        { "arc": "payoff", "label": "Oldest light", "match": { "roles": ["galaxy", "globular"], "maxObsDifficulty": 3 }, "inEdges": ["TIME_MACHINE", "SCALE"] }
      ],
      "order": "partial", "swapGroups": [[1, 2]],
      "edges": ["TIME_MACHINE", "SCALE", "SIBLING", "LINE_OF_SIGHT", "CONTRAST"],
      "progression": { "property": "distanceLy", "direction": "up" },
      "length": [4, 7], "defaultLength": 5,
      "ingredients": { "factSpans": [{ "fact": "distanceLy", "minRatio": 100 }], "minHistoryHooks": 1 },
      "coreConcepts": ["DIST.light-year", "TIME.lookback", "GAL.other"],
      "moonFriendly": false, "moonSuitability": "partial", "needsDark": false, "kidFriendly": true,
      "chainTo": ["A3-how-far"],
      "switchRule": { "to": ["A3-how-far"], "atArc": "payoff", "via": ["SCALE", "TIME_MACHINE"], "minStrength": 0.5, "announceKey": "switch.A4-time-machine" }
    },
    {
      "id": "A5-families", "archetype": "A5", "title": "Families and Siblings",
      "titleKeys": ["title.A5-families"],
      "drivingQuestion": "Do stars have families?",
      "questionKeys": ["question.A5-families"],
      "hookLine": "Meet star families at every age, from tight-knit newborns to scattered siblings.",
      "hookKeys": ["hook.A5-families"],
      "payoffKeys": ["payoff.A5-families"],
      "themeTags": ["clusters", "families", "moving-groups"],
      "orderingPrinciple": "From tight to loose and young to old (ageMyr rises): a jewel-box cluster, then looser and older clusters, then a dissolving association or moving group.",
      "slots": [
        { "arc": "hook", "label": "Jewel box", "match": { "roles": ["young-cluster", "adult-cluster"], "minWow": 4, "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Older family", "match": { "roles": ["young-cluster", "adult-cluster", "old-cluster"] }, "repeat": [1, 3], "inEdges": ["LIFE_NEXT", "SAME_FAMILY", "CONTRAST", "SIBLING"] },
        { "arc": "twist", "label": "Scattered family", "match": { "roles": ["association"], "anyConcepts": ["MW.families", "KIN.moving-group"] }, "optional": true, "inEdges": ["SIBLING", "CONTRAST", "LINE_OF_SIGHT", "LIFE_NEXT"] },
        { "arc": "payoff", "label": "Lost siblings", "match": { "roles": ["association", "old-cluster", "adult-cluster"], "anyConcepts": ["MW.families", "KIN.moving-group", "LIFE.cluster-age"] }, "inEdges": ["LIFE_NEXT", "CONTRAST", "SIBLING", "SAME_FAMILY"] },
        { "arc": "coda", "label": "Family portrait", "match": { "roles": ["association"], "maxObsDifficulty": 1 }, "optional": true }
      ],
      "order": "partial", "swapGroups": [[2, 3]],
      "edges": ["SIBLING", "SAME_FAMILY", "LIFE_NEXT", "CONTRAST", "LINE_OF_SIGHT"],
      "progression": { "property": "ageMyr", "direction": "up" },
      "length": [4, 6], "defaultLength": 5,
      "ingredients": {
        "roles": [{ "anyOf": ["young-cluster", "adult-cluster", "old-cluster", "association"], "min": 3 }],
        "factSpans": [{ "fact": "ageMyr", "minRatio": 10 }]
      },
      "coreConcepts": ["LIFE.cluster-birth", "MW.families", "LIFE.cluster-age"],
      "moonFriendly": true, "moonSuitability": "bright-ok", "needsDark": false, "kidFriendly": true,
      "chainTo": ["A1-cradle-to-grave"],
      "switchRule": { "to": ["A1-cradle-to-grave"], "atArc": "payoff", "via": ["LIFE_NEXT", "SIBLING"], "minStrength": 0.7, "announceKey": "switch.A5-families" }
    },
    {
      "id": "A6-contrasts", "archetype": "A6", "title": "Same Sky, Different Stories",
      "titleKeys": ["title.A6-contrasts"],
      "drivingQuestion": "Why do these neighbors look so different?",
      "questionKeys": ["question.A6-contrasts"],
      "hookLine": "Pairs that look alike but live opposite lives. Spot the difference, then learn why.",
      "hookKeys": ["hook.A6-contrasts"],
      "payoffKeys": ["payoff.A6-contrasts"],
      "themeTags": ["contrasts", "pairs"],
      "orderingPrinciple": "Two or three pairs. Each pair shares at least one obvious trait and differs sharply on one axis (temperature, age, distance, size, life stage). Pairs are linked to the next pair by a shared idea. The deepest contrast comes last.",
      "slots": [
        { "arc": "hook", "label": "Pair opener", "match": { "minWow": 3, "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Its opposite", "match": {}, "inEdges": ["CONTRAST", "LINE_OF_SIGHT"] },
        { "arc": "build", "label": "New pair", "match": {}, "inEdges": ["SAME_PHYSICS", "SAME_FAMILY", "SIBLING", "CONTRAST"] },
        { "arc": "twist", "label": "Unlikely opposite", "match": { "hasMisconception": true }, "optional": true, "inEdges": ["CONTRAST", "LINE_OF_SIGHT"] },
        { "arc": "build", "label": "Last pair", "match": {}, "optional": true, "inEdges": ["SAME_PHYSICS", "SAME_FAMILY", "SIBLING"] },
        { "arc": "payoff", "label": "Deepest contrast", "match": { "minInterest": 0.6, "maxObsDifficulty": 3 }, "inEdges": ["CONTRAST", "LINE_OF_SIGHT"] }
      ],
      "order": "strict",
      "edges": ["CONTRAST", "LINE_OF_SIGHT", "SAME_PHYSICS", "SAME_FAMILY", "SIBLING"],
      "length": [4, 6], "defaultLength": 4,
      "ingredients": { "minDistinctEvoStages": 2 },
      "coreConcepts": ["SKY.projection", "LIGHT.color-temp", "LIFE.cluster-age"],
      "moonFriendly": false, "moonSuitability": "partial", "needsDark": false, "kidFriendly": true,
      "chainTo": ["A2-thermometer"],
      "switchRule": { "to": ["A2-thermometer"], "atArc": "payoff", "via": ["CONTRAST"], "minStrength": 0.7, "announceKey": "switch.A6-contrasts" }
    },
    {
      "id": "A7-record-breakers", "retired": true, "archetype": "A7", "title": "Record Breakers",
      "titleKeys": ["title.A7-record-breakers"],
      "drivingQuestion": "What are the most extreme things you can see tonight?",
      "questionKeys": ["question.A7-record-breakers"],
      "hookLine": "Biggest, hottest, oldest, farthest: tonight's record holders, and why they're extreme.",
      "hookKeys": ["hook.A7-record-breakers"],
      "payoffKeys": ["payoff.A7-record-breakers"],
      "themeTags": ["superlatives", "records", "kids"],
      "orderingPrinciple": "By category, not by brightness: every stop holds a different record, and each link says why the next holder is extreme (most luminous because most massive). Record scopes must be honest for tonight's sky.",
      "slots": [
        { "arc": "hook", "label": "Biggest star", "match": { "kinds": ["star"], "superlativeTags": ["largest-star-in-view", "most-luminous-in-view", "brightest-star"], "maxObsDifficulty": 2 } },
        { "arc": "build", "label": "Another record", "match": { "superlativeTags": ["hottest-star-in-view", "coolest-star-in-view", "reddest-star", "most-luminous-in-view", "most-massive", "youngest", "oldest", "nearest", "fastest-moving", "fastest-spinning", "richest-cluster", "largest-apparent", "brightest-star"] }, "repeat": [2, 4], "inEdges": ["CONTRAST", "SCALE", "SAME_PHYSICS", "CAUSE"] },
        { "arc": "payoff", "label": "Farthest thing", "match": { "superlativeTags": ["farthest", "farthest-naked-eye", "oldest"], "maxObsDifficulty": 3 }, "inEdges": ["SCALE", "TIME_MACHINE", "CONTRAST"] },
        { "arc": "coda", "label": "Ordinary Sun", "match": { "kinds": ["star"], "anyConcepts": ["PLAN.solar-twin"] }, "optional": true }
      ],
      "order": "partial", "swapGroups": [[0, 1]],
      "edges": ["CONTRAST", "SCALE", "SAME_PHYSICS", "TIME_MACHINE", "CAUSE"],
      "length": [4, 7], "defaultLength": 5,
      "ingredients": { "minSuperlatives": 4 },
      "coreConcepts": ["STAR.size", "STAR.mass-fate", "SCALE.cosmic"],
      "moonFriendly": false, "moonSuitability": "partial", "needsDark": false, "kidFriendly": true,
      "chainTo": ["A6-contrasts"],
      "switchRule": { "to": ["A6-contrasts"], "atArc": "payoff", "via": ["CONTRAST"], "minStrength": 0.7, "announceKey": "switch.A7-record-breakers" }
    },
    {
